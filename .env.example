# --- Supabase (create project, then Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo mode (dev only) ---
# When "true", enables an in-memory demo backend: sign in with
# test@prodraw.ai (magic-link step is skipped), or use the "Try the demo"
# button, with no Supabase or Stripe required. Leave unset/false in production.
NEXT_PUBLIC_DEMO_MODE=false

# --- Stripe (Dashboard > Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Six recurring prices under one product: 3 currencies × monthly/yearly
# Early adopter: A$15 / US$10 / £8 monthly; yearly = 20% off
STRIPE_PRICE_AUD_MONTHLY=price_xxx
STRIPE_PRICE_AUD_YEARLY=price_xxx
STRIPE_PRICE_USD_MONTHLY=price_xxx
STRIPE_PRICE_USD_YEARLY=price_xxx
STRIPE_PRICE_GBP_MONTHLY=price_xxx
STRIPE_PRICE_GBP_YEARLY=price_xxx
