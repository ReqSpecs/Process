# --- Supabase (create project, then Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo mode (dev only) ---
# When "true", enables an in-memory demo backend: sign in with
# test@prodraw.ai / 123, or use the "Try the demo" button, with no Supabase or
# Stripe required. Leave unset/false in production.
NEXT_PUBLIC_DEMO_MODE=false

# --- Stripe (Dashboard > Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# One recurring price per currency (same product, multi-currency)
STRIPE_PRICE_AUD=price_xxx
STRIPE_PRICE_USD=price_xxx
STRIPE_PRICE_EUR=price_xxx
STRIPE_PRICE_GBP=price_xxx
